#ifndef SECRETS_H
#define SECRETS_H

// =============================================================================
// PEOPLE DETECTION SYSTEM - CREDENTIALS AND CONFIGURATION TEMPLATE
// =============================================================================
// Copy this file to secrets.h and replace placeholders with your actual
// Wi-Fi network credentials and Supabase project configurations.
//
// IMPORTANT SECURITY NOTICE:
// Never use the Supabase 'service_role' key on the ESP32. Only use the public
// 'anon' key. The service_role key bypasses Row Level Security and must remain
// strictly confidential on backend servers.
// =============================================================================

// Wi-Fi Network Credentials
#define WIFI_SSID           "YOUR_WIFI_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"

// Supabase REST API Configuration
// Replace with your project reference: e.g. "https://xyzcompanyproject.supabase.co"
#define SUPABASE_URL        "https://your-project-id.supabase.co"

// Supabase Anon (Public) Key - Found in Supabase Project Settings -> API
#define SUPABASE_ANON_KEY   "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

#endif // SECRETS_H
